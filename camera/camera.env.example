# Copy to camera.env (untracked) and fill in. Never commit camera.env:
# it holds the device key and a Spring password. After copying, run
#   chmod 600 camera.env
# so only your account can read it.

# ---- OCS (Flask) -------------------------------------------------------
# OCS base URL: the same BACKEND_URL as the Pi's reader.env (the
# classroom server in Jarvis3000#17 is http://192.168.1.242:8587).
# Rehearsal mode only runs against a local OCS, e.g. http://localhost:8587.
BACKEND_URL=http://192.168.1.242:8587
# Must match RFID_API_KEY in flask_csh/.env (the same key as reader.env).
RFID_API_KEY=
# OCS presence room whose taps to answer: the same ROOM_ID as the Pi's
# reader.env.
ROOM_ID=1
# Optional label stored with each result. Leave it unset: camera mode then
# uses mac-mini-cam and the test modes use camera-test-tool, so test
# results are easy to tell apart. Rehearsal mode adds "-rehearsal".
# DEVICE_ID=mac-mini-cam

# ---- Camera (--mode camera and the setup checks) ----------------------
# Which camera to use. 0 is usually the first one plugged in. Run
# python camera_client.py --list-cameras to see the numbers. An iPhone
# nearby (Continuity Camera) can show up as a camera too.
CAMERA_INDEX=0
# A face counts as a match at this score or above (0 to 1). 0.363 is the
# standard value for this model. Raise it if the wrong person is matched;
# lower it if the right person is often "no match". Use --preview to see
# real scores before changing it.
MATCH_THRESHOLD=0.363
# How long to keep looking for a face after a tap is picked up, in seconds
# (0 to 5). Students often look down at the tap pad for a moment.
FACE_WAIT_SECONDS=3

# ---- Reference faces ---------------------------------------------------
# Where the registered faces come from:
#   spring  the faces students registered on their OCS profile page
#           (needs a Teacher login below)
#   folder  photos in camera/faces/ named <uid>.jpg (or .png), with more
#           photos of the same person as <uid>_2.jpg, <uid>_3.jpg, ...
FACE_SOURCE=spring
SPRING_URL=https://spring.opencodingsociety.com
# A Teacher account on Spring (Admin works too, but it can do far more
# than read faces, so prefer a Teacher account). Only used to log in;
# never printed. A student account gets "403": use FACE_SOURCE=folder.
# Keep the single quotes around the password, so symbols like $ or ! in it
# are read as they are.
SPRING_UID=
SPRING_PASSWORD=''
# Only keep these people's faces (comma-separated OCS uids, no spaces
# needed), e.g. FACE_UIDS=vibham,kush1434. Strongly recommended: list just
# the demo team. Spring still sends every registered face when the client
# starts, but only these are kept and compared; the rest are dropped right
# away. Anyone not listed is sent as not_enrolled ("Tap only"). Empty =
# keep every registered face.
FACE_UIDS=

# ---- Model files (optional) --------------------------------------------
# Defaults are camera/models/<file>; get them with ./get_models.sh.
# Relative paths count from the camera/ folder.
# FACE_DETECTOR_MODEL=models/face_detection_yunet_2023mar.onnx
# FACE_RECOGNIZER_MODEL=models/face_recognition_sface_2021dec.onnx
