# Copy to reader.env (untracked) and fill in. Never commit reader.env.
BACKEND_URL=http://<flask-host>:8587
RFID_API_KEY=<same value as RFID_API_KEY in flask_csh/.env>
ROOM_ID=1
DEVICE_ID=pi-room1
# Which reader is attached: rc522 (RC522 board, default) or
# pn532 (Waveshare PN532 NFC HAT, set to UART mode: I0=L, I1=L).
READER=rc522
# pn532 only: the Pi's serial port (enable it in raspi-config first).
PN532_PORT=/dev/serial0
