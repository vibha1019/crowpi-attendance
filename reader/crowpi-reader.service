[Unit]
Description=CrowPi RFID attendance reader
After=network-online.target
Wants=network-online.target

[Service]
# Adjust User/WorkingDirectory/ExecStart if your CrowPi username or the
# repo's location on disk differs from these defaults.
User=pi
WorkingDirectory=/home/pi/crowpi-attendance/reader
ExecStart=/usr/bin/python3 /home/pi/crowpi-attendance/reader/reader.py --backend http://192.168.1.242:5050
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
